<Window x:Class="GoogleDesktopWidget.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Google Widget" 
        Height="650" Width="390"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Topmost="False"
        FontFamily="{StaticResource M3Font}">

    <Window.Resources>
        <!-- Storyboard for Pulsing 'Now' indicator -->
        <Storyboard x:Key="PulseStoryboard" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                             From="1.0" To="0.3" Duration="0:0:1">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </Window.Resources>

    <!-- Outer Wrapper with Shadow for Material Elevation -->
    <Grid Margin="16">
        <Border x:Name="RootCard"
                CornerRadius="24"
                Background="{DynamicResource BrushSurface}"
                BorderBrush="{DynamicResource BrushOutline}"
                BorderThickness="1"
                ClipToBounds="True">
            
            <Border.Effect>
                <DropShadowEffect BlurRadius="28" 
                                  Color="#000000" 
                                  Opacity="0.55" 
                                  ShadowDepth="6" 
                                  Direction="270" />
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Header / Drag Area -->
                    <RowDefinition Height="Auto"/> <!-- Tab Segmented Bar -->
                    <RowDefinition Height="*"/>    <!-- Content Pages -->
                </Grid.RowDefinitions>

                <!-- 1. Header (Drag handle, Live Date, Actions) -->
                <Grid Grid.Row="0" Margin="20,16,20,10" Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Vertical">
                        <TextBlock x:Name="HeaderDateText" 
                                   Text="Tuesday, Sep 8" 
                                   FontSize="18" 
                                   FontWeight="Bold" 
                                   Foreground="{DynamicResource BrushTextPrimary}"/>
                        <TextBlock x:Name="SyncStatusText" 
                                   Text="Synced with Google" 
                                   FontSize="11" 
                                   Foreground="{DynamicResource BrushTextSecondary}" 
                                   Margin="0,2,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="SyncButton" Style="{StaticResource M3IconButton}" Click="SyncButton_Click" ToolTip="Sync Now">
                            <TextBlock Text="🔄" FontSize="14"/>
                        </Button>
                        <Button Style="{StaticResource M3IconButton}" Click="SettingsNavButton_Click" ToolTip="Settings" Margin="4,0,0,0">
                            <TextBlock Text="⚙" FontSize="15"/>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- 2. Segmented Pill Navigation -->
                <Border Grid.Row="1" Margin="20,0,20,12" Background="{DynamicResource BrushSurfaceVariant}" CornerRadius="18" Padding="3">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <RadioButton x:Name="TabAgendaRadio" Content="Agenda" IsChecked="True" 
                                     Checked="TabAgendaRadio_Checked"
                                     HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                            <RadioButton.Template>
                                <ControlTemplate TargetType="RadioButton">
                                    <Border x:Name="pill" CornerRadius="15" Background="Transparent" Padding="0,7">
                                        <TextBlock Text="{TemplateBinding Content}" 
                                                   HorizontalAlignment="Center" 
                                                   FontWeight="SemiBold" 
                                                   FontSize="12"
                                                   Foreground="{DynamicResource BrushTextSecondary}"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="pill" Property="Background" Value="{DynamicResource BrushPrimary}"/>
                                            <Setter TargetName="pill" Property="TextBlock.Foreground" Value="{DynamicResource BrushOnPrimary}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </RadioButton.Template>
                        </RadioButton>

                        <RadioButton x:Name="TabTasksRadio" Grid.Column="1" Content="Tasks &amp; Notes" 
                                     Checked="TabTasksRadio_Checked"
                                     HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                            <RadioButton.Template>
                                <ControlTemplate TargetType="RadioButton">
                                    <Border x:Name="pill" CornerRadius="15" Background="Transparent" Padding="0,7">
                                        <TextBlock Text="{TemplateBinding Content}" 
                                                   HorizontalAlignment="Center" 
                                                   FontWeight="SemiBold" 
                                                   FontSize="12"
                                                   Foreground="{DynamicResource BrushTextSecondary}"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="pill" Property="Background" Value="{DynamicResource BrushPrimary}"/>
                                            <Setter TargetName="pill" Property="TextBlock.Foreground" Value="{DynamicResource BrushOnPrimary}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </RadioButton.Template>
                        </RadioButton>
                    </Grid>
                </Border>

                <!-- 3. Dynamic Content Hosts -->
                <Grid Grid.Row="2" Margin="16,0,16,16">

                    <!-- PAGE 1: AGENDA -->
                    <ScrollViewer x:Name="AgendaView" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="AgendaContainer">
                            <!-- Currently Active Event Highlight Card -->
                            <Border x:Name="ActiveEventCard" Visibility="Collapsed" 
                                    Background="{DynamicResource BrushPrimaryContainer}" 
                                    CornerRadius="16" Padding="14" Margin="0,0,0,12"
                                    BorderBrush="{DynamicResource BrushAccent}" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Width="10" Height="10" Fill="{DynamicResource BrushAccent}" 
                                             VerticalAlignment="Top" Margin="0,4,12,0">
                                        <Ellipse.Triggers>
                                            <EventTrigger RoutedEvent="Loaded">
                                                <BeginStoryboard Storyboard="{StaticResource PulseStoryboard}"/>
                                            </EventTrigger>
                                        </Ellipse.Triggers>
                                    </Ellipse>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="NOW HAPPENING" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrushAccent}"/>
                                        <TextBlock x:Name="ActiveEventTitle" Text="Standup Meeting" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,2,0,0"/>
                                        <TextBlock x:Name="ActiveEventTime" Text="14:00 - 14:30" FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Items List -->
                            <ItemsControl x:Name="EventsItemsControl">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,8" Background="{DynamicResource BrushSurfaceVariant}" 
                                                CornerRadius="14" Padding="12"
                                                MouseLeftButtonUp="EventCard_Click" Cursor="Hand">
                                            <StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" 
                                                               Foreground="{DynamicResource BrushTextPrimary}" TextTrimming="CharacterEllipsis"/>
                                                    <Border Grid.Column="1" Background="{DynamicResource BrushOutline}" CornerRadius="8" Padding="6,2">
                                                        <TextBlock Text="{Binding RelativeTimeStatus}" FontSize="10" Foreground="{DynamicResource BrushTextPrimary}"/>
                                                    </Border>
                                                </Grid>
                                                
                                                <TextBlock Text="{Binding DisplayTimeRange}" FontSize="11" 
                                                           Foreground="{DynamicResource BrushTextSecondary}" Margin="0,4,0,0"/>

                                                <!-- Expandable details -->
                                                <StackPanel Visibility="{Binding IsExpanded, Converter={x:Static BooleanToVisibilityConverter.Instance}}" Margin="0,8,0,0">
                                                    <TextBlock Text="{Binding Location}" FontSize="11" Foreground="{DynamicResource BrushPrimary}" Margin="0,0,0,4" TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Empty Placeholder -->
                            <TextBlock x:Name="AgendaEmptyState" Text="No upcoming events. Enter iCal URL in Settings." 
                                       Foreground="{DynamicResource BrushTextSecondary}" FontSize="12" 
                                       HorizontalAlignment="Center" Margin="0,40,0,0" Visibility="Collapsed" TextAlignment="Center"/>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- PAGE 2: TASKS & SCRATCHPAD -->
                    <Grid x:Name="TasksNotesView" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="120"/>
                        </Grid.RowDefinitions>

                        <!-- Task Add Input -->
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="NewTaskBox" Style="{StaticResource M3TextBox}" KeyDown="NewTaskBox_KeyDown"/>
                            <Button Grid.Column="1" Style="{StaticResource M3PillButton}" Content="Add" Margin="8,0,0,0" Click="AddTaskButton_Click"/>
                        </Grid>

                        <!-- Tasks List -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10">
                            <ItemsControl x:Name="TasksItemsControl">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,6" Background="{DynamicResource BrushSurfaceVariant}" CornerRadius="10" Padding="8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <CheckBox IsChecked="{Binding IsCompleted}" VerticalAlignment="Center" Click="TaskCheckBox_Click" Tag="{Binding Id}"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Content}" VerticalAlignment="Center" Margin="8,0"
                                                           Foreground="{DynamicResource BrushTextPrimary}" FontSize="12" TextTrimming="CharacterEllipsis">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                                    <Setter Property="TextDecorations" Value="Strikethrough"/>
                                                                    <Setter Property="Opacity" Value="0.45"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <Button Grid.Column="2" Style="{StaticResource M3IconButton}" Width="24" Height="24" 
                                                        Click="DeleteTaskButton_Click" Tag="{Binding Id}">
                                                    <TextBlock Text="✕" FontSize="10"/>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- Scratchpad Title -->
                        <TextBlock Grid.Row="2" Text="Scratchpad (Auto-saved)" FontSize="11" FontWeight="SemiBold" 
                                   Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,4"/>

                        <!-- Scratchpad Editor -->
                        <TextBox Grid.Row="3" x:Name="ScratchpadBox" 
                                 Style="{StaticResource M3TextBox}" 
                                 AcceptsReturn="True" 
                                 TextWrapping="Wrap" 
                                 VerticalScrollBarVisibility="Auto"
                                 TextChanged="ScratchpadBox_TextChanged"/>
                    </Grid>

                    <!-- MODAL / DRAWER: SETTINGS -->
                    <Border x:Name="SettingsModal" Background="{DynamicResource BrushSurface}" CornerRadius="20" 
                            BorderBrush="{DynamicResource BrushOutline}" BorderThickness="1"
                            Visibility="Collapsed" Padding="16">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <TextBlock Text="Widget Settings" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}"/>
                                    <Button HorizontalAlignment="Right" Style="{StaticResource M3IconButton}" Click="CloseSettingsButton_Click">
                                        <TextBlock Text="✕" FontSize="12"/>
                                    </Button>
                                </Grid>

                                <!-- Theme Chooser -->
                                <TextBlock Text="Material Theme Accent" FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,4,0,4"/>
                                <ComboBox x:Name="ThemeComboBox" SelectionChanged="ThemeComboBox_SelectionChanged" Margin="0,0,0,12">
                                    <ComboBoxItem Content="Google Blue" IsSelected="True"/>
                                    <ComboBoxItem Content="Emerald Forest"/>
                                    <ComboBoxItem Content="Sunset Coral"/>
                                    <ComboBoxItem Content="AMOLED True Black"/>
                                </ComboBox>

                                <!-- Opacity Slider -->
                                <TextBlock Text="Surface Transparency" FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,4,0,4"/>
                                <Slider x:Name="OpacitySlider" Minimum="0.2" Maximum="1.0" Value="0.94" 
                                        ValueChanged="OpacitySlider_ValueChanged" Margin="0,0,0,12"/>

                                <!-- Toggles -->
                                <CheckBox x:Name="AcrylicCheck" Content="Windows 11 Acrylic Blur" 
                                          Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,8" 
                                          Click="AcrylicCheck_Click"/>
                                <CheckBox x:Name="PinToDesktopCheck" Content="Pin to Desktop (Send to Back)" 
                                          Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,8" 
                                          Click="PinToDesktopCheck_Click"/>
                                <CheckBox x:Name="AutoStartCheck" Content="Start with Windows" 
                                          Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,14" 
                                          Click="AutoStartCheck_Click"/>

                                <!-- iCal URL -->
                                <TextBlock Text="Google Calendar iCal (.ics) URL" FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,4,0,4"/>
                                <TextBox x:Name="CalendarUrlBox" Style="{StaticResource M3TextBox}" Margin="0,0,0,8"/>

                                <!-- Buttons -->
                                <Button Content="Save &amp; Sync Calendar" Style="{StaticResource M3PillButton}" Click="SaveSettingsButton_Click" Margin="0,4,0,8"/>
                                <Button Content="Reset Widget Position" Background="{DynamicResource BrushSurfaceVariant}" 
                                        Foreground="{DynamicResource BrushTextPrimary}" Style="{StaticResource M3PillButton}" 
                                        Click="ResetPositionButton_Click"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
